      "name": "01. Autenticação (Auth)",
      "item": [
        {
          "name": "Login (Guarda Token Automático)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code é 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Login com sucesso e token presente', function () {",
                  "    pm.expect(json.status).to.eql('success');",
                  "    pm.expect(json.token).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(json.user).to.be.an('object');",
                  "});",
                  "if (json.token) {",
                  "    pm.environment.set('token', json.token);",
                  "    console.log('Token guardado no Environment!');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            }
          }
        },
